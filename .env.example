# Synthetic use only. Server binds to loopback by default.
INBODY_HOST=127.0.0.1
INBODY_PORT=8080
INBODY_DATABASE_URL=sqlite:///runtime/inbody.db
INBODY_STORAGE_DIR=runtime/sources
# Set both for authenticated mode; role is assigned server-side, never by client.
INBODY_CLINICIAN_TOKEN=
INBODY_OPERATOR_TOKEN=
INBODY_WEBHOOK_TOKEN=
# Paid/local AI is opt-in. No identifiers or source files are sent.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Live vendor connector intentionally not enabled until validated mapping exists.
INBODY_ACCOUNT=
INBODY_API_KEY=
GOOGLE_DRIVE_ENABLED=false
